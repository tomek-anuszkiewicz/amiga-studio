{
  "rust-analyzer.debug.engine": "ms-vscode.cpptools",
  "debug.allowBreakpointsEverywhere": true,
  "editor.formatOnSave": true,
  "[rust]": {
    "editor.defaultFormatter": "rust-lang.rust-analyzer"
  },
  "search.exclude": {
    "/graphify-out": true,
    "**/.git": true,
    "**/target": true
  },
  "workbench.editorAssociations": {
    "**/.agents/rules/**/*.md": "default",
    "**/.agents/workflows/**/*.md": "default",
    "**/_agents/rules/**/*.md": "default",
    "**/_agents/workflows/**/*.md": "default",
    "**/.gemini/**/global_workflows/*.md": "default"
  }
}