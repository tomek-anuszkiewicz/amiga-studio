    },
    {
      "type": "code_block",
      "continuation": false,
      "heading_level": null,
      "md_text": "```text\nAttributes:    Format = (Byte, Word, Long, Single, Double, Extended, Packed)\n```",
      "bbox": [
        262,
        921,
        2148,
        991
      ],
      "segment_id": "page_0058_seg_007"
    },
    {
      "type": "prose",
      "continuation": false,
      "heading_level": null,
      "md_text": "**Description:** Converts the source operand to extended precision (if necessary) and divides that number into the number in the destination floating-point data register. Stores the result in the destination floating-point data register.",
      "bbox": [
        262,
        1029,
        2265,
        1216
      ],
      "segment_id": "page_0058_seg_008"
    },
    {
      "type": "prose",
      "continuation": false,
      "heading_level": null,
      "md_text": "FDIV will round the result to the precision selected in the floating-point control register. FSDIV and FDDIV will round the result to single or double precision, respectively, regardless of the rounding precision selected in the floating-point control register.",
      "bbox": [
        374,
        1254,
        2265,
        1441
      ],
      "segment_id": "page_0058_seg_009"
    },
    {
      "type": "caption",
      "continuation": false,
      "heading_level": null,
      "md_text": "Operation Table:",
      "bbox": [
