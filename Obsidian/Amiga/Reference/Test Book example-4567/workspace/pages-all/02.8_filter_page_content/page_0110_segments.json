    },
    {
      "type": "prose",
      "continuation": false,
      "heading_level": null,
      "md_text": "COLOR00 is always reserved for the background color. The background color shows in any area on the display where there is no other object present and is also displayed outside the defined display window, in the border area.",
      "bbox": [
        357,
        1702,
        2161,
        1855
      ],
      "segment_id": "page_0110_seg_005"
    },
    {
      "type": "callout",
      "continuation": false,
      "heading_level": null,
      "md_text": "**NOTE**",
      "bbox": [
        1187,
        1916,
        1315,
        1961
      ],
      "segment_id": "page_0110_seg_006"
    },
    {
      "type": "callout_text",
      "continuation": false,
      "heading_level": null,
      "md_text": "If you are using the optional genlock board for video input from a camera, VCR, or laser disk, the background color will be replaced by the incoming video display.",
      "bbox": [
        459,
        1996,
        2058,
        2093
      ],
      "segment_id": "page_0110_seg_007"
    },
    {
      "type": "prose",
      "continuation": false,
      "heading_level": null,
      "md_text": "Twelve bits of color selection allow you to define, for each of the 32 registers, one of 4,096 possible colors, as shown in Table 3-3.",
