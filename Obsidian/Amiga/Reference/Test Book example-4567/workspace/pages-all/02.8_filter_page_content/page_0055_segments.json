      "segment_id": "page_0055_seg_011"
    },
    {
      "type": "callout_text",
      "continuation": false,
      "heading_level": null,
      "md_text": "The Dn mode is used when the destination is a data register; the destination < ea > mode is invalid for a data register.",
      "bbox": [
        562,
        1737,
        1964,
        1865
      ],
      "segment_id": "page_0055_seg_012"
    },
    {
      "type": "callout_text",
      "continuation": false,
      "heading_level": null,
      "md_text": "ADDA is used when the destination is an address register. ADDI and ADDQ are used when the source is immediate data. Most assemblers automatically make this distinction.",
      "bbox": [
        562,
        1904,
        1965,
        2091
      ],
      "segment_id": "page_0055_seg_013"
    }
  ]
