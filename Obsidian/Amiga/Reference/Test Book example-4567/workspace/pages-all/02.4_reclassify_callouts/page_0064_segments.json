    },
    {
      "type": "callout",
      "continuation": false,
      "heading_level": null,
      "md_text": "**Note:**",
      "bbox": [
        789,
        2349,
        2040,
        2553
      ],
      "segment_id": "page_0064_seg_010",
      "source_segment_ids": [
        "page_0064_seg_010"
      ],
      "replacement_stage": "02.4_reclassify_callouts"
    },
    {
      "type": "callout_text",
      "continuation": false,
      "heading_level": null,
      "md_text": "On the U.S. keyboard, the keys with codes 44 and 60 are extended to include the European keys with codes 2B and 30, respectively. Also note that England uses the U.S. rather than the European keyboard, but not the U.S. keymap.",
      "bbox": [
        789,
        2349,
        2040,
        2553
      ],
      "segment_id": "page_0064_seg_010_callout_2",
      "source_segment_ids": [
        "page_0064_seg_010"
      ],
      "replacement_stage": "02.4_reclassify_callouts"
    },
    {
      "type": "prose",
      "continuation": false,
      "heading_level": null,
      "md_text": "See Table 1-1 at the end of this section for a table of the raw key codes.",
      "bbox": [
        795,
        2707,
        2005,
        2801
      ],
