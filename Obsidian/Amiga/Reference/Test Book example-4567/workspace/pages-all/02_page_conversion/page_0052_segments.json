    {
      "type": "prose",
      "continuation": false,
      "heading_level": null,
      "md_text": "Register Rx field—Specifies the destination register.\n\nIf R/M = 0, specifies a data register.\nIf R/M = 1, specifies an address register for the predecrement addressing mode.",
      "bbox": [
        401,
        771,
        2240,
        957
