    },
    {
      "type": "prose",
      "continuation": false,
      "heading_level": null,
      "md_text": "R/M field—Specifies the operand addressing mode.\n\n0 — The operation is data register to data register.\n1 — The operation is memory to memory.",
      "bbox": [
        401,
        996,
        1591,
        1182
      ],
