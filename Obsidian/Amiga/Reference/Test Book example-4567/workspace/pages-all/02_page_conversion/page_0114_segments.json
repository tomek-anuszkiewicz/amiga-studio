    {
      "type": "caption",
      "continuation": false,
      "heading_level": null,
      "md_text": "Figure 3-20: Display Window Vertical Starting Position",
      "bbox": [
        737,
        2154,
        1768,
        2201
      ],
      "segment_id": "page_0114_seg_005"
    },
    {
      "type": "prose",
      "continuation": false,
      "heading_level": null,
      "md_text": "Recall that you select the values for the starting position as if the display were in low-resolution, non-interlaced mode. Keep in mind, though, that for interlaced mode the display window should be an even number of lines in height to allow for equal-sized odd and even fields.",
      "bbox": [
        353,
        2317,
        2160,
        2470
      ],
      "segment_id": "page_0114_seg_006"
    },
    {
      "type": "prose",
      "continuation": false,
      "heading_level": null,
      "md_text": "To set the display window starting position, write the value for HSTART into bits 0 through 7 and the value for VSTART into bits 8 through 15 of DIWSTRT.",
      "bbox": [
        354,
        2530,
        2160,
        2631
      ],
      "segment_id": "page_0114_seg_007"
    },
