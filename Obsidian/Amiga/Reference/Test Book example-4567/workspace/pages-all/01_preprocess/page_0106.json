        0.7873740641379585,
        0.23023936617313812
      ]
    },
    {
      "block_id": 3,
      "type": 0,
      "text": "WAIT for any horizontal position with \nvertical position 0 through 5, covering \nthe last 6 lines of the scan before vertical \nblanking occurs.\n",
      "bbox": [
        129.9129638671875,
        194.91888427734375,
        312.1090393066406,
        244.01885986328125
      ],
      "bbox_norm": [
        0.21622249250533243,
        0.2525248523660572,
        0.5194631267231945,
        0.3161357443121336
      ]
    },
    {
      "block_id": 4,
      "type": 0,
      "text": "Thus the total of 256 + 6 = 262 \nlines of video beam travel \nduring \nwhich \nCopper \ninstructions can be executed.\n",
      "bbox": [
        325.762939453125,
        195.06610107421875,
        472.137939453125,
        244.21112060546875
      ],
      "bbox_norm": [
        0.5421881899825467,
