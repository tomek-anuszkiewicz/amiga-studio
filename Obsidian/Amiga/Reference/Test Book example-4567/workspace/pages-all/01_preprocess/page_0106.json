    {
      "block_id": 2,
      "type": 0,
      "text": "WAIT for position (0,255)\nAt \nthis point, \nthe \nvertical \ncounter appears to wrap to 0 \nbecause the comparison works \non the least significant bits of \nthe vertical count.\n",
      "bbox": [
        129.9530029296875,
