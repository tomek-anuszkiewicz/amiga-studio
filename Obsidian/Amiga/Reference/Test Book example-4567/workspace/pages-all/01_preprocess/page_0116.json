        0.5272425362903836,
        0.4957332402797869
      ]
    },
    {
      "block_id": 13,
      "type": 0,
      "text": "1. \nDecide which of the eight sprite DMA channels to use (making certain that the chosen \nchannel is available).\n",
      "bbox": [
        106.44900512695312,
        397.9455871582031,
        518.0070190429688,
        421.79559326171875
      ],
      "bbox_norm": [
