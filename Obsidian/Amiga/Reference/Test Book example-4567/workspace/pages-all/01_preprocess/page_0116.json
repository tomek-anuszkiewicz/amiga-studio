      ]
    },
    {
      "block_id": 12,
      "type": 0,
      "text": "The following steps are used in displaying the sprite:\n",
      "bbox": [
        85.30000305175781,
        372.1465759277344,
        316.78314208984375,
        382.6465759277344
      ],
      "bbox_norm": [
        0.14197027549474558,
