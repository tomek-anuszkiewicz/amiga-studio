        0.862152363079273,
        0.5464522860982208
      ]
    },
    {
      "block_id": 14,
      "type": 0,
      "text": "2. \nSet the sprite pointers to tell the system where to find the sprite data.\n",
      "bbox": [
        105.2490005493164,
        437.194580078125,
        425.05804443359375,
        447.694580078125
      ],
      "bbox_norm": [
        0.17517267372741505,
        0.566402261118942,
        0.7074514127845808,
        0.5800054117817113
      ]
    },
    {
      "block_id": 15,
      "type": 0,
      "text": "3. \nTurn on sprite direct memory access if it is not already on.\n",
      "bbox": [
        105.4990005493164,
        462.89459228515625,
        380.6935119628906,
        473.39459228515625
      ],
