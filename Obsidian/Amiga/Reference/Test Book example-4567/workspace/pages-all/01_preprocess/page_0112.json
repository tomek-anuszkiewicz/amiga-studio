        0.8610204044108497,
        0.6858515277213062
      ]
    },
    {
      "block_id": 12,
      "type": 0,
      "text": "You can control the two playfields separately as follows:\n",
      "bbox": [
        85.54782104492188,
        545.0940551757812,
        333.00140380859375,
        555.5940551757812
