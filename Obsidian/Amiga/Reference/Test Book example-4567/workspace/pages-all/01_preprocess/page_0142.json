      ]
    },
    {
      "block_id": 17,
      "type": 0,
      "text": "TRANSMIT SHIFT REGISTER EMPTY\nWhen this bit is a 1, the output shift register has completed\nits task, all data has been transmitted, and the register is\nnow idle. If you stop writing data into the output register\n(SERDAT), then this bit will become a 1 after both the word\ncurrently in the shift register and the word placed\ninto SERDAT have been transmitted.\n",
      "bbox": [
        226.88265991210938,
        453.74310302734375,
        492.1611022949219,
        541.881103515625
