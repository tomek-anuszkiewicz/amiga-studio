        0.8338590851136819,
        0.3118555025816666
      ]
    },
    {
      "block_id": 7,
      "type": 0,
      "text": "14 \nRBF \nREAD BUFFER FULL\n",
      "bbox": [
        113.2229995727539,
        256.0140380859375,
        328.1159362792969,
