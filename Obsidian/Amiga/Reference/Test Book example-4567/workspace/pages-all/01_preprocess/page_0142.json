    {
      "block_id": 6,
      "type": 0,
      "text": "(Mirror— also appears in the interrupt request register.)\nIndicates that another byte of data was received before the \nprevious byte was picked up by the processor. To prevent this \ncondition, it is necessary to reset INTF_RBF (bit 11, \nreceive-buffer-full) in INTREQ.\n",
      "bbox": [
        226.23300170898438,
        178.62103271484375,
        501.007568359375,
        240.71502685546875
      ],
      "bbox_norm": [
