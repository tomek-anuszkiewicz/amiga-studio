        0.45288887409248735
      ]
    },
    {
      "block_id": 18,
      "type": 0,
      "text": "X — Set the same as the carry bit. \nN — Undeﬁned. \nZ — Cleared if the result is nonzero; unchanged otherwise. \nV — Undeﬁned. \nC — Set if a decimal carry was generated; cleared otherwise. \n",
      "bbox": [
