        0.41445296802699755
      ]
    },
    {
      "block_id": 6,
      "type": 0,
      "text": "The line goes from (xl,yl) to (x2,y2).\n",
      "bbox": [
        121.27999114990234,
        335.4542236328125,
        284.5315246582031,
        345.95697021484375
      ],
      "bbox_norm": [
