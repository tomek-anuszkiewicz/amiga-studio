{
  "language-policy-guard": {
    "PreToolUse": [
      {
        "matcher": "write_to_file|replace_file_content|multi_replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "python hooks/check_polish.py --hook",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
